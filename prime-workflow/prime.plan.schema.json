{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/settanun-prime/prime-studio-mods/prime-workflow/prime.plan.schema.json",
  "title": "Prime plan (.prime/plan.json)",
  "type": "object",
  "required": ["version", "title", "status", "goal", "streams"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "accepted"] },
    "acceptedAt": { "type": "string" },
    "planHash": { "type": "string" },
    "goal": { "type": "string", "minLength": 1 },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "base": { "type": "string" },
    "integration": { "type": "string", "pattern": "^prime/[a-z0-9][a-z0-9._-]{0,80}$" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "replanTriggers": { "type": "array", "items": { "type": "string" } },
    "blastRadius": {
      "type": "object",
      "properties": {
        "affectedModules": { "type": "array", "items": { "type": "string" } },
        "sharedState": { "type": "array", "items": { "type": "string" } },
        "externalDependents": { "type": "array", "items": { "type": "string" } },
        "dataMigrations": { "type": "boolean" }
      }
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "role", "paths", "acceptance"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,59}$" },
          "playbook": { "enum": ["feature", "bug-fix", "refactor", "perf", "investigation"] },
          "role": { "enum": ["claude-code", "codex", "hermes"] },
          "summary": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "acceptance": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
